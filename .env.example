APP_NAME="Sahabat SOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sahabatsos.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sahabatsos_prod
DB_USERNAME=sahabatsos_user
DB_PASSWORD=secret_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# CORS & Sanctum
CORS_ALLOWED_ORIGINS="https://admin.sahabatsos.id,https://app.sahabatsos.id"
SANCTUM_STATEFUL_DOMAINS="admin.sahabatsos.id,app.sahabatsos.id"

# Broadcasting (Laravel Reverb WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sahabat-sos-app-id
REVERB_APP_KEY=sahabat-sos-app-key
REVERB_APP_SECRET=sahabat-sos-app-secret
REVERB_HOST=api.sahabatsos.id
REVERB_PORT=443
REVERB_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Third-party Integrations
GOOGLE_CLIENT_ID=
MAPBOX_ACCESS_TOKEN=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sahabatsos.id"
MAIL_FROM_NAME="${APP_NAME}"
